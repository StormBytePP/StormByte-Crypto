# Generated by CMake — do not edit in the build tree.
$ErrorActionPreference = "Stop"

$OutDir   = "@KEYPAIR_OPENSSL_DIR@"
$TestPass = "@KEYPAIR_TEST_PASS@"

$OutDir = $OutDir -replace '/', '\'

function Write-Step([string]$Label) {
	Write-Host -NoNewline "$Label..."
}

function Fail([string]$Message) {
	Write-Host " ERROR" -ForegroundColor Red
	Write-Error $Message
	exit 1
}

# Do not use [CmdletBinding]/param here: -out/-in would bind to -OutVariable/-OutBuffer.
function Invoke-OpenSsl {
	& openssl @args
	if ($LASTEXITCODE -ne 0) {
		Fail "openssl $($args -join ' ') failed with exit code $LASTEXITCODE"
	}
}

function Write-Truncated([string]$Src, [string]$Dst) {
	if (-not (Test-Path -LiteralPath $Src)) {
		Fail "Missing file for truncate: $Src"
	}
	$bytes = [System.IO.File]::ReadAllBytes($Src)
	$half  = [Math]::Max(1, [int]($bytes.Length / 2))
	$prefix = New-Object byte[] $half
	[Array]::Copy($bytes, $prefix, $half)
	[System.IO.File]::WriteAllBytes($Dst, $prefix)
}

if (-not (Get-Command openssl -ErrorAction SilentlyContinue)) {
	Write-Error "openssl not found in PATH"
	exit 2
}

if (Test-Path -LiteralPath $OutDir) {
	Remove-Item -LiteralPath $OutDir -Recurse -Force
}
New-Item -ItemType Directory -Path $OutDir -Force | Out-Null

Write-Host "Generating keypairs into: ${OutDir}"
Write-Host ""

Write-Step "Generating RSA 2048"
Invoke-OpenSsl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "${OutDir}\rsa_test.priv.pem"
Invoke-OpenSsl pkey -in "${OutDir}\rsa_test.priv.pem" -pubout -out "${OutDir}\rsa_test.pub.pem"
Invoke-OpenSsl pkey -in "${OutDir}\rsa_test.priv.pem" -outform DER -out "${OutDir}\rsa_test.priv.der"
Invoke-OpenSsl pkey -in "${OutDir}\rsa_test.priv.pem" -pubout -outform DER -out "${OutDir}\rsa_test.pub.der"
Invoke-OpenSsl pkcs8 -topk8 -v2 aes-256-cbc -in "${OutDir}\rsa_test.priv.pem" -out "${OutDir}\rsa_test.priv.enc.pem" -passout "pass:$TestPass"
# Explicit PKCS#1 (RSAPrivateKey)
Invoke-OpenSsl rsa -in "${OutDir}\rsa_test.priv.pem" -outform DER -out "${OutDir}\rsa_test.priv.pkcs1.der"
Invoke-OpenSsl rsa -in "${OutDir}\rsa_test.priv.pem" -traditional -out "${OutDir}\rsa_test.priv.pkcs1.pem"
Write-Host " OK"

Write-Step "Generating DSA 2048"
Invoke-OpenSsl dsaparam -out "${OutDir}\dsaparam.pem" 2048
Invoke-OpenSsl gendsa -out "${OutDir}\dsa_test.priv.pem" "${OutDir}\dsaparam.pem"
Invoke-OpenSsl pkey -in "${OutDir}\dsa_test.priv.pem" -pubout -out "${OutDir}\dsa_test.pub.pem"
Remove-Item -LiteralPath "${OutDir}\dsaparam.pem" -Force -ErrorAction SilentlyContinue
Invoke-OpenSsl pkey -in "${OutDir}\dsa_test.priv.pem" -outform DER -out "${OutDir}\dsa_test.priv.der"
Invoke-OpenSsl pkey -in "${OutDir}\dsa_test.priv.pem" -pubout -outform DER -out "${OutDir}\dsa_test.pub.der"
Invoke-OpenSsl pkcs8 -topk8 -v2 aes-256-cbc -in "${OutDir}\dsa_test.priv.pem" -out "${OutDir}\dsa_test.priv.enc.pem" -passout "pass:$TestPass"
Write-Host " OK"

Write-Step "Generating ECC P-256"
Invoke-OpenSsl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out "${OutDir}\ecc_p256_test.priv.pem"
Invoke-OpenSsl pkey -in "${OutDir}\ecc_p256_test.priv.pem" -pubout -out "${OutDir}\ecc_p256_test.pub.pem"
Invoke-OpenSsl pkey -in "${OutDir}\ecc_p256_test.priv.pem" -outform DER -out "${OutDir}\ecc_p256_test.priv.der"
Invoke-OpenSsl pkey -in "${OutDir}\ecc_p256_test.priv.pem" -pubout -outform DER -out "${OutDir}\ecc_p256_test.pub.der"
Invoke-OpenSsl pkcs8 -topk8 -v2 aes-256-cbc -in "${OutDir}\ecc_p256_test.priv.pem" -out "${OutDir}\ecc_p256_test.priv.enc.pem" -passout "pass:$TestPass"
Invoke-OpenSsl ec -in "${OutDir}\ecc_p256_test.priv.pem" -outform DER -out "${OutDir}\ecc_p256_test.priv.sec1.der"
Invoke-OpenSsl ec -in "${OutDir}\ecc_p256_test.priv.pem" -out "${OutDir}\ecc_p256_test.priv.sec1.pem"
Copy-Item "${OutDir}\ecc_p256_test.priv.pem"     "${OutDir}\ecdsa_test.priv.pem" -Force
Copy-Item "${OutDir}\ecc_p256_test.pub.pem"      "${OutDir}\ecdsa_test.pub.pem" -Force
Copy-Item "${OutDir}\ecc_p256_test.priv.der"     "${OutDir}\ecdsa_test.priv.der" -Force
Copy-Item "${OutDir}\ecc_p256_test.pub.der"      "${OutDir}\ecdsa_test.pub.der" -Force
Copy-Item "${OutDir}\ecc_p256_test.priv.enc.pem" "${OutDir}\ecdsa_test.priv.enc.pem" -Force
Copy-Item "${OutDir}\ecc_p256_test.priv.sec1.der" "${OutDir}\ecdsa_test.priv.sec1.der" -Force
Copy-Item "${OutDir}\ecc_p256_test.priv.sec1.pem" "${OutDir}\ecdsa_test.priv.sec1.pem" -Force
Write-Host " OK"

Write-Step "Generating ECDH P-256 local + peer"
Invoke-OpenSsl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out "${OutDir}\ecdh_test.priv.pem"
Invoke-OpenSsl pkey -in "${OutDir}\ecdh_test.priv.pem" -pubout -out "${OutDir}\ecdh_test.pub.pem"
Invoke-OpenSsl pkey -in "${OutDir}\ecdh_test.priv.pem" -outform DER -out "${OutDir}\ecdh_test.priv.der"
Invoke-OpenSsl pkey -in "${OutDir}\ecdh_test.priv.pem" -pubout -outform DER -out "${OutDir}\ecdh_test.pub.der"
Invoke-OpenSsl pkcs8 -topk8 -v2 aes-256-cbc -in "${OutDir}\ecdh_test.priv.pem" -out "${OutDir}\ecdh_test.priv.enc.pem" -passout "pass:$TestPass"
Invoke-OpenSsl ec -in "${OutDir}\ecdh_test.priv.pem" -outform DER -out "${OutDir}\ecdh_test.priv.sec1.der"
Invoke-OpenSsl ec -in "${OutDir}\ecdh_test.priv.pem" -out "${OutDir}\ecdh_test.priv.sec1.pem"
Invoke-OpenSsl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out "${OutDir}\ecdh_peer_test.priv.pem"
Invoke-OpenSsl pkey -in "${OutDir}\ecdh_peer_test.priv.pem" -pubout -out "${OutDir}\ecdh_peer_test.pub.pem"
Invoke-OpenSsl pkey -in "${OutDir}\ecdh_peer_test.priv.pem" -outform DER -out "${OutDir}\ecdh_peer_test.priv.der"
Invoke-OpenSsl pkey -in "${OutDir}\ecdh_peer_test.priv.pem" -pubout -outform DER -out "${OutDir}\ecdh_peer_test.pub.der"
Write-Host " OK"

Write-Step "Generating ED25519"
Invoke-OpenSsl genpkey -algorithm ED25519 -out "${OutDir}\ed25519_test.priv.pem"
Invoke-OpenSsl pkey -in "${OutDir}\ed25519_test.priv.pem" -pubout -out "${OutDir}\ed25519_test.pub.pem"
Invoke-OpenSsl pkey -in "${OutDir}\ed25519_test.priv.pem" -outform DER -out "${OutDir}\ed25519_test.priv.der"
Invoke-OpenSsl pkey -in "${OutDir}\ed25519_test.priv.pem" -pubout -outform DER -out "${OutDir}\ed25519_test.pub.der"
Invoke-OpenSsl pkcs8 -topk8 -v2 aes-256-cbc -in "${OutDir}\ed25519_test.priv.pem" -out "${OutDir}\ed25519_test.priv.enc.pem" -passout "pass:$TestPass"
Write-Host " OK"

Write-Step "Generating X25519 local + peer"
Invoke-OpenSsl genpkey -algorithm X25519 -out "${OutDir}\x25519_test.priv.pem"
Invoke-OpenSsl pkey -in "${OutDir}\x25519_test.priv.pem" -pubout -out "${OutDir}\x25519_test.pub.pem"
Invoke-OpenSsl pkey -in "${OutDir}\x25519_test.priv.pem" -outform DER -out "${OutDir}\x25519_test.priv.der"
Invoke-OpenSsl pkey -in "${OutDir}\x25519_test.priv.pem" -pubout -outform DER -out "${OutDir}\x25519_test.pub.der"
Invoke-OpenSsl pkcs8 -topk8 -v2 aes-256-cbc -in "${OutDir}\x25519_test.priv.pem" -out "${OutDir}\x25519_test.priv.enc.pem" -passout "pass:$TestPass"
Invoke-OpenSsl genpkey -algorithm X25519 -out "${OutDir}\x25519_peer_test.priv.pem"
Invoke-OpenSsl pkey -in "${OutDir}\x25519_peer_test.priv.pem" -pubout -out "${OutDir}\x25519_peer_test.pub.pem"
Invoke-OpenSsl pkey -in "${OutDir}\x25519_peer_test.priv.pem" -outform DER -out "${OutDir}\x25519_peer_test.priv.der"
Invoke-OpenSsl pkey -in "${OutDir}\x25519_peer_test.priv.pem" -pubout -outform DER -out "${OutDir}\x25519_peer_test.pub.der"
Write-Host " OK"

Write-Step "Writing truncated invalid private keys"
Write-Truncated "${OutDir}\rsa_test.priv.pem"      "${OutDir}\rsa_test.priv.truncated.pem"
Write-Truncated "${OutDir}\dsa_test.priv.pem"      "${OutDir}\dsa_test.priv.truncated.pem"
Write-Truncated "${OutDir}\ecc_p256_test.priv.pem" "${OutDir}\ecc_p256_test.priv.truncated.pem"
Write-Truncated "${OutDir}\ecdsa_test.priv.pem"    "${OutDir}\ecdsa_test.priv.truncated.pem"
Write-Truncated "${OutDir}\ecdh_test.priv.pem"     "${OutDir}\ecdh_test.priv.truncated.pem"
Write-Truncated "${OutDir}\ed25519_test.priv.pem"  "${OutDir}\ed25519_test.priv.truncated.pem"
Write-Truncated "${OutDir}\x25519_test.priv.pem"   "${OutDir}\x25519_test.priv.truncated.pem"
Write-Host " OK"

Write-Host ""
Write-Host "Generated files in ${OutDir}:"
Get-ChildItem -LiteralPath $OutDir | ForEach-Object { $_.Name }
Write-Host ""
Write-Host "Encrypted private keys passphrase: $TestPass"
Write-Host "PKCS#1 RSA: *.priv.pkcs1.der / *.priv.pkcs1.pem"
Write-Host "SEC1 EC:    *.priv.sec1.der / *.priv.sec1.pem"
Write-Host "Truncated:  *.priv.truncated.pem"
Write-Host "Done."
exit 0
