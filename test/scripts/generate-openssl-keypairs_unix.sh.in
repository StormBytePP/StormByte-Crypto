#!/usr/bin/env bash
set -euo pipefail

# Generated by CMake — do not edit the .sh in the build tree.
OUTDIR="@KEYPAIR_OPENSSL_DIR@"
TEST_PASS="@KEYPAIR_TEST_PASS@"

rm -rf "$OUTDIR"
mkdir -p "$OUTDIR"

if ! command -v openssl >/dev/null 2>&1; then
	echo "openssl not found in PATH" >&2
	exit 2
fi

run_step() {
	local label=$1
	shift
	echo -n "${label}..."
	if "$@" >/dev/null 2>&1; then
		echo " OK"
	else
		echo " ERROR" >&2
		exit 1
	fi
}

echo "Generating keypairs into: $OUTDIR"
echo

run_step "Generating RSA 2048" bash -c "
	openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out \"$OUTDIR/rsa_test.priv.pem\" &&
	openssl pkey -in \"$OUTDIR/rsa_test.priv.pem\" -pubout -out \"$OUTDIR/rsa_test.pub.pem\" &&
	openssl pkey -in \"$OUTDIR/rsa_test.priv.pem\" -outform DER -out \"$OUTDIR/rsa_test.priv.der\" &&
	openssl pkey -in \"$OUTDIR/rsa_test.priv.pem\" -pubout -outform DER -out \"$OUTDIR/rsa_test.pub.der\" &&
	openssl pkcs8 -topk8 -v2 aes-256-cbc -in \"$OUTDIR/rsa_test.priv.pem\" -out \"$OUTDIR/rsa_test.priv.enc.pem\" -passout \"pass:${TEST_PASS}\" &&
	# Explicit PKCS#1 (RSAPrivateKey) — do not overwrite *.priv.der from pkey
	openssl rsa -in \"$OUTDIR/rsa_test.priv.pem\" -outform DER -out \"$OUTDIR/rsa_test.priv.pkcs1.der\" &&
	openssl rsa -in \"$OUTDIR/rsa_test.priv.pem\" -traditional -out \"$OUTDIR/rsa_test.priv.pkcs1.pem\"
"

run_step "Generating DSA 2048" bash -c "
	openssl dsaparam -out \"$OUTDIR/dsaparam.pem\" 2048 &&
	openssl gendsa -out \"$OUTDIR/dsa_test.priv.pem\" \"$OUTDIR/dsaparam.pem\" &&
	openssl pkey -in \"$OUTDIR/dsa_test.priv.pem\" -pubout -out \"$OUTDIR/dsa_test.pub.pem\" &&
	rm -f \"$OUTDIR/dsaparam.pem\" &&
	openssl pkey -in \"$OUTDIR/dsa_test.priv.pem\" -outform DER -out \"$OUTDIR/dsa_test.priv.der\" &&
	openssl pkey -in \"$OUTDIR/dsa_test.priv.pem\" -pubout -outform DER -out \"$OUTDIR/dsa_test.pub.der\" &&
	openssl pkcs8 -topk8 -v2 aes-256-cbc -in \"$OUTDIR/dsa_test.priv.pem\" -out \"$OUTDIR/dsa_test.priv.enc.pem\" -passout \"pass:${TEST_PASS}\"
"

run_step "Generating ECC P-256" bash -c "
	openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out \"$OUTDIR/ecc_p256_test.priv.pem\" &&
	openssl pkey -in \"$OUTDIR/ecc_p256_test.priv.pem\" -pubout -out \"$OUTDIR/ecc_p256_test.pub.pem\" &&
	openssl pkey -in \"$OUTDIR/ecc_p256_test.priv.pem\" -outform DER -out \"$OUTDIR/ecc_p256_test.priv.der\" &&
	openssl pkey -in \"$OUTDIR/ecc_p256_test.priv.pem\" -pubout -outform DER -out \"$OUTDIR/ecc_p256_test.pub.der\" &&
	openssl pkcs8 -topk8 -v2 aes-256-cbc -in \"$OUTDIR/ecc_p256_test.priv.pem\" -out \"$OUTDIR/ecc_p256_test.priv.enc.pem\" -passout \"pass:${TEST_PASS}\" &&
	# Explicit SEC1 traditional EC private (not PKCS#1; not overwriting *.priv.der)
	openssl ec -in \"$OUTDIR/ecc_p256_test.priv.pem\" -outform DER -out \"$OUTDIR/ecc_p256_test.priv.sec1.der\" &&
	openssl ec -in \"$OUTDIR/ecc_p256_test.priv.pem\" -out \"$OUTDIR/ecc_p256_test.priv.sec1.pem\" &&
	cp \"$OUTDIR/ecc_p256_test.priv.pem\" \"$OUTDIR/ecdsa_test.priv.pem\" &&
	cp \"$OUTDIR/ecc_p256_test.pub.pem\"  \"$OUTDIR/ecdsa_test.pub.pem\" &&
	cp \"$OUTDIR/ecc_p256_test.priv.der\" \"$OUTDIR/ecdsa_test.priv.der\" &&
	cp \"$OUTDIR/ecc_p256_test.pub.der\"  \"$OUTDIR/ecdsa_test.pub.der\" &&
	cp \"$OUTDIR/ecc_p256_test.priv.enc.pem\" \"$OUTDIR/ecdsa_test.priv.enc.pem\" &&
	cp \"$OUTDIR/ecc_p256_test.priv.sec1.der\" \"$OUTDIR/ecdsa_test.priv.sec1.der\" &&
	cp \"$OUTDIR/ecc_p256_test.priv.sec1.pem\" \"$OUTDIR/ecdsa_test.priv.sec1.pem\"
"

run_step "Generating ECDH P-256 local + peer" bash -c "
	openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out \"$OUTDIR/ecdh_test.priv.pem\" &&
	openssl pkey -in \"$OUTDIR/ecdh_test.priv.pem\" -pubout -out \"$OUTDIR/ecdh_test.pub.pem\" &&
	openssl pkey -in \"$OUTDIR/ecdh_test.priv.pem\" -outform DER -out \"$OUTDIR/ecdh_test.priv.der\" &&
	openssl pkey -in \"$OUTDIR/ecdh_test.priv.pem\" -pubout -outform DER -out \"$OUTDIR/ecdh_test.pub.der\" &&
	openssl pkcs8 -topk8 -v2 aes-256-cbc -in \"$OUTDIR/ecdh_test.priv.pem\" -out \"$OUTDIR/ecdh_test.priv.enc.pem\" -passout \"pass:${TEST_PASS}\" &&
	openssl ec -in \"$OUTDIR/ecdh_test.priv.pem\" -outform DER -out \"$OUTDIR/ecdh_test.priv.sec1.der\" &&
	openssl ec -in \"$OUTDIR/ecdh_test.priv.pem\" -out \"$OUTDIR/ecdh_test.priv.sec1.pem\" &&
	openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out \"$OUTDIR/ecdh_peer_test.priv.pem\" &&
	openssl pkey -in \"$OUTDIR/ecdh_peer_test.priv.pem\" -pubout -out \"$OUTDIR/ecdh_peer_test.pub.pem\" &&
	openssl pkey -in \"$OUTDIR/ecdh_peer_test.priv.pem\" -outform DER -out \"$OUTDIR/ecdh_peer_test.priv.der\" &&
	openssl pkey -in \"$OUTDIR/ecdh_peer_test.priv.pem\" -pubout -outform DER -out \"$OUTDIR/ecdh_peer_test.pub.der\"
"

run_step "Generating ED25519" bash -c "
	openssl genpkey -algorithm ED25519 -out \"$OUTDIR/ed25519_test.priv.pem\" &&
	openssl pkey -in \"$OUTDIR/ed25519_test.priv.pem\" -pubout -out \"$OUTDIR/ed25519_test.pub.pem\" &&
	openssl pkey -in \"$OUTDIR/ed25519_test.priv.pem\" -outform DER -out \"$OUTDIR/ed25519_test.priv.der\" &&
	openssl pkey -in \"$OUTDIR/ed25519_test.priv.pem\" -pubout -outform DER -out \"$OUTDIR/ed25519_test.pub.der\" &&
	openssl pkcs8 -topk8 -v2 aes-256-cbc -in \"$OUTDIR/ed25519_test.priv.pem\" -out \"$OUTDIR/ed25519_test.priv.enc.pem\" -passout \"pass:${TEST_PASS}\"
"

run_step "Generating X25519 local + peer" bash -c "
	openssl genpkey -algorithm X25519 -out \"$OUTDIR/x25519_test.priv.pem\" &&
	openssl pkey -in \"$OUTDIR/x25519_test.priv.pem\" -pubout -out \"$OUTDIR/x25519_test.pub.pem\" &&
	openssl pkey -in \"$OUTDIR/x25519_test.priv.pem\" -outform DER -out \"$OUTDIR/x25519_test.priv.der\" &&
	openssl pkey -in \"$OUTDIR/x25519_test.priv.pem\" -pubout -outform DER -out \"$OUTDIR/x25519_test.pub.der\" &&
	openssl pkcs8 -topk8 -v2 aes-256-cbc -in \"$OUTDIR/x25519_test.priv.pem\" -out \"$OUTDIR/x25519_test.priv.enc.pem\" -passout \"pass:${TEST_PASS}\" &&
	openssl genpkey -algorithm X25519 -out \"$OUTDIR/x25519_peer_test.priv.pem\" &&
	openssl pkey -in \"$OUTDIR/x25519_peer_test.priv.pem\" -pubout -out \"$OUTDIR/x25519_peer_test.pub.pem\" &&
	openssl pkey -in \"$OUTDIR/x25519_peer_test.priv.pem\" -outform DER -out \"$OUTDIR/x25519_peer_test.priv.der\" &&
	openssl pkey -in \"$OUTDIR/x25519_peer_test.priv.pem\" -pubout -outform DER -out \"$OUTDIR/x25519_peer_test.pub.der\"
"

run_step "Writing truncated invalid private keys" bash -c "
	write_truncated() {
		local src=\$1
		local dst=\$2
		local size half
		size=\$(wc -c < \"\$src\" | tr -d ' ')
		half=\$(( size / 2 ))
		[[ \"\$half\" -lt 1 ]] && half=1
		head -c \"\$half\" \"\$src\" > \"\$dst\"
	}
	write_truncated \"$OUTDIR/rsa_test.priv.pem\"       \"$OUTDIR/rsa_test.priv.truncated.pem\"
	write_truncated \"$OUTDIR/dsa_test.priv.pem\"       \"$OUTDIR/dsa_test.priv.truncated.pem\"
	write_truncated \"$OUTDIR/ecc_p256_test.priv.pem\"  \"$OUTDIR/ecc_p256_test.priv.truncated.pem\"
	write_truncated \"$OUTDIR/ecdsa_test.priv.pem\"     \"$OUTDIR/ecdsa_test.priv.truncated.pem\"
	write_truncated \"$OUTDIR/ecdh_test.priv.pem\"      \"$OUTDIR/ecdh_test.priv.truncated.pem\"
	write_truncated \"$OUTDIR/ed25519_test.priv.pem\"   \"$OUTDIR/ed25519_test.priv.truncated.pem\"
	write_truncated \"$OUTDIR/x25519_test.priv.pem\"    \"$OUTDIR/x25519_test.priv.truncated.pem\"
"

chmod 600 "$OUTDIR"/*.priv.pem "$OUTDIR"/*.priv.der "$OUTDIR"/*.priv.enc.pem \
	"$OUTDIR"/*.priv.truncated.pem "$OUTDIR"/*.priv.pkcs1.der "$OUTDIR"/*.priv.pkcs1.pem \
	"$OUTDIR"/*.priv.sec1.der "$OUTDIR"/*.priv.sec1.pem 2>/dev/null || true

echo
echo "Generated files in $OUTDIR:"
ls -la "$OUTDIR"
echo
echo "Encrypted private keys passphrase: ${TEST_PASS}"
echo "PKCS#1 RSA: *.priv.pkcs1.der / *.priv.pkcs1.pem"
echo "SEC1 EC:    *.priv.sec1.der / *.priv.sec1.pem"
echo "Truncated:  *.priv.truncated.pem"
echo "Done."
